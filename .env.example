# ==============================================================================
# LifeLink - Environment Configuration Template
# Duplicate this file as '.env' and update the values for your environment.
# IMPORTANT: NEVER commit your actual '.env' containing real secrets to git!
# ==============================================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# Generate a secure key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=lifelink-dev-secret-key-change-in-production-2026

# ==============================================================================
# Database Configuration Options
# Choose Option A (Single URL) OR Option B (Individual Parameters):
# ==============================================================================

# Option A: Cloud Database URL (Aiven, TiDB Cloud, Railway, Render, etc.)
# DATABASE_URL=mysql://username:password@host.provider.com:3306/lifelink_db?ssl-mode=REQUIRED

# Option B: Individual Database Parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lifelink_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=10
DB_AUTOCOMMIT=false

# Cloud SSL/TLS Configuration:
# - AUTO            : Enables SSL automatically for remote cloud hosts, disables for localhost
# - REQUIRED        : Enforces SSL/TLS encrypted connection
# - DISABLED        : Disables SSL (use for local XAMPP/MySQL)
# - VERIFY_CA       : Enforces SSL and verifies CA certificate
# - VERIFY_IDENTITY : Enforces SSL and verifies full hostname
DB_SSL_MODE=AUTO
# DB_SSL_CA=/path/to/ca-certificate.pem

# Application Meta
APP_NAME=LifeLink
APP_TAGLINE="Smart Blood Donor and Emergency Blood Availability Portal"
APP_URL=http://127.0.0.1:5000
