# ==============================================================================
# LifeLink - Environment Configuration Template
# Duplicate this file as '.env' and update the values for your local environment.
# IMPORTANT: NEVER commit the actual '.env' file containing real secrets to git!
# ==============================================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# Generate a secure key in production (e.g., using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=lifelink-dev-secret-key-change-in-production-2026

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lifelink_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_CHARSET=utf8mb4

# Database Connection Pool / Timeout Settings
DB_CONNECT_TIMEOUT=10
DB_AUTOCOMMIT=false

# Application Meta
APP_NAME=LifeLink
APP_TAGLINE="Smart Blood Donor and Emergency Blood Availability Portal"
APP_URL=http://127.0.0.1:5000
